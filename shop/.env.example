# Stripe test mode only. Copy to .env (gitignored). Do not commit real keys.
# Dashboard: Developers → API keys, with "Test mode" on. Never paste sk_live_ or pk_live_.
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_

# Origin Stripe uses for success and cancel. No path, no trailing slash.
SHOP_BASE_URL=http://127.0.0.1:8765

# Used only when STRIPE_SECRET_KEY is empty.
# SHOP_PAYID=
# SHOP_PAYID_NAME=Rogers Inc Designs
# SHOP_CHECKOUT=demo
