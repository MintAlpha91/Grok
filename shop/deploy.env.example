# Deploy env for the Rogers Inc Designs shop. Set these in the host dashboard.
SHOP_PAYID=0499420228
SHOP_PAYID_NAME="Rogers Inc Designs"
# Leave STRIPE_SECRET_KEY unset (PayID path). Never commit keys.
# Railway sets PORT. The server binds 0.0.0.0:$PORT.
# Orders volume on the live service:
# SHOP_ORDERS_DIR=/data/orders
# SHOP_ADMIN_PASSWORD=          # chosen password for /admin (Mark paid)
# STRIPE_SECRET_KEY=            # sk_live_… or sk_test_…  Developers → API keys
# STRIPE_WEBHOOK_SECRET=        # whsec_…  Developers → Webhooks → checkout.session.completed
# STRIPE_PUBLISHABLE_KEY=       # optional pk_live_… / pk_test_…
# PRINTFUL_API_KEY=             # Printful Settings → API → private token
# PRINTFUL_STORE_ID=            # optional, Printful Settings → Stores
# PRINTFUL_AUTO_CONFIRM=false   # true submits to production; false keeps a draft
# SHOP_ALERT_EMAIL=rogersinc426@gmail.com
# SMTP_HOST=smtp.gmail.com      # or smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=                    # Gmail app password or Resend API key
# SMTP_FROM=rogersinc426@gmail.com
